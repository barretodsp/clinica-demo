{
  "uid": "clinica-saude-api",
  "title": "Clínica — Saúde da API",
  "description": "Disponibilidade da API, do banco e do PACS (sonda externa) e tráfego HTTP (logs no Loki).",
  "tags": [
    "clinica"
  ],
  "timezone": "America/Sao_Paulo",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API (backend)",
      "description": "UP se a API respondeu à última sondagem de GET /api/health/ready (últimos 60 s). DOWN: sem resposta (container parado, travado ou timeout de 5 s).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "last_over_time({app=\"uptime\", target=\"clinic-api\"} | json | unwrap apiUp [1m]) by (target)",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                },
                "-1": {
                  "text": "DESCONHECIDO",
                  "color": "text",
                  "index": 2
                }
              }
            }
          ],
          "noValue": "SEM DADOS",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "transformations": []
    },
