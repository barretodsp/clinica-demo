    {
      "id": 10,
      "type": "timeseries",
      "title": "Respostas por status HTTP",
      "description": "Inclui 401/403/409/422/429/5xx.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (statusCode) (count_over_time({app=\"clinic-api\"} | json | event=\"http.request\" [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{statusCode}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "transformations": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Erros por rota (4xx/5xx)",
