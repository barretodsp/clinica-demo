    {
      "id": 9,
      "type": "state-timeline",
      "title": "Histórico UP/DOWN",
      "description": "Pior estado em cada intervalo (uma queda curta não some na agregação). Faixa vazia = sem sondagem.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "min_over_time({app=\"uptime\", target=\"clinic-api\"} | json | unwrap apiUp [$__auto]) by (target)",
