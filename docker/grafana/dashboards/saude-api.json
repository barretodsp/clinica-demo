          },
          "refId": "A",
          "expr": "sum by (route, statusCode) (count_over_time({app=\"clinic-api\"} | json | event=\"http.request\" | statusCode >= 400 [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{statusCode}} {{route}}"
        }
