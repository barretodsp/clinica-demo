          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM medical_report r JOIN appointment a ON a.id = r.appointment_id\nWHERE r.status = 'PUBLISHED' AND $__timeFilter(r.published_at) AND a.clinic_id::text IN (${clinic:sqlstring})"
        }
      ],
      "options": {
