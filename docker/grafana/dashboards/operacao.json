    {
      "id": 3,
      "type": "stat",
      "title": "Laudos publicados",
      "description": "Por data de publicação.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clinicdb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
