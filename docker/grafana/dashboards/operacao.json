              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "transformations": []
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Exames agendados por tipo (empilhado por clínica)",
      "description": "Por data do exame (starts_at).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clinicdb"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clinicdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT e.name AS tipo, c.name AS clinica, count(*)::int AS total\nFROM appointment a JOIN exam_type e ON e.id = a.exam_type_id JOIN clinic c ON c.id = a.clinic_id\nWHERE a.status = 'SCHEDULED' AND $__timeFilter(a.starts_at) AND a.clinic_id::text IN (${clinic:sqlstring})\nGROUP BY 1, 2 ORDER BY 1, 2"
        }
      ],
      "options": {
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "clinica",
            "rowField": "tipo",
            "valueField": "total",
            "emptyValue": "zero"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Médicos com mais laudos publicados",
      "description": "Somente laudos publicados, por data de publicação.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clinicdb"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clinicdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT u.name AS medico, count(*) AS laudos\nFROM medical_report r\nJOIN appointment a ON a.id = r.appointment_id\nJOIN doctor d ON d.id = r.doctor_id\nJOIN \"user\" u ON u.id = d.user_id\nWHERE r.status = 'PUBLISHED' AND $__timeFilter(r.published_at) AND a.clinic_id::text IN (${clinic:sqlstring})\nGROUP BY u.name ORDER BY laudos DESC LIMIT 10"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": ""
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "transformations": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Ocupação da agenda (agendamentos ativos por dia da semana × horário local)",
      "description": "Mapa de calor: horários de pico e ociosos (cor = volume).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clinicdb"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clinicdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(a.starts_at AT TIME ZONE c.timezone, 'HH24:MI') AS \"Horário\",\n  count(*) FILTER (WHERE extract(isodow FROM a.starts_at AT TIME ZONE c.timezone) = 1) AS \"Seg\",\n  count(*) FILTER (WHERE extract(isodow FROM a.starts_at AT TIME ZONE c.timezone) = 2) AS \"Ter\",\n  count(*) FILTER (WHERE extract(isodow FROM a.starts_at AT TIME ZONE c.timezone) = 3) AS \"Qua\",\n  count(*) FILTER (WHERE extract(isodow FROM a.starts_at AT TIME ZONE c.timezone) = 4) AS \"Qui\",\n  count(*) FILTER (WHERE extract(isodow FROM a.starts_at AT TIME ZONE c.timezone) = 5) AS \"Sex\"\nFROM appointment a JOIN clinic c ON c.id = a.clinic_id\nWHERE a.status = 'SCHEDULED' AND $__timeFilter(a.starts_at) AND a.clinic_id::text IN (${clinic:sqlstring})\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            },
            "align": "center"
          },
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "transformations": []
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Tempo até a publicação do laudo (horas, média e p90)",
      "description": "published_at − starts_at, por médico.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clinicdb"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clinicdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT u.name AS medico,\n  round(avg(extract(epoch FROM r.published_at - a.starts_at) / 3600)::numeric, 1) AS \"Média (h)\",\n  round(percentile_cont(0.9) WITHIN GROUP (ORDER BY extract(epoch FROM r.published_at - a.starts_at) / 3600)::numeric, 1) AS \"P90 (h)\"\nFROM medical_report r\nJOIN appointment a ON a.id = r.appointment_id\nJOIN doctor d ON d.id = r.doctor_id JOIN \"user\" u ON u.id = d.user_id\nWHERE r.status = 'PUBLISHED' AND $__timeFilter(r.published_at) AND a.clinic_id::text IN (${clinic:sqlstring})\nGROUP BY u.name ORDER BY 2 DESC"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": []
    }
  ]
