    {
      "id": 4,
      "type": "stat",
      "title": "Taxa de cancelamento",
      "description": "Cancelados ÷ total, entre os exames com data no período.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clinicdb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clinicdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 0 ELSE 100.0 * count(*) FILTER (WHERE a.status = 'CANCELLED') / count(*) END AS value\nFROM appointment a WHERE $__timeFilter(a.starts_at) AND a.clinic_id::text IN (${clinic:sqlstring})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "teal"
          }
        },
        "overrides": []
      },
      "transformations": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Agendamentos criados por dia (por clínica)",
      "description": "Dia no fuso de cada clínica.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clinicdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clinicdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT (date_trunc('day', a.created_at AT TIME ZONE c.timezone) AT TIME ZONE c.timezone) AS time,\n       c.name AS metric, count(*) AS value\nFROM appointment a JOIN clinic c ON c.id = a.clinic_id\nWHERE $__timeFilter(a.created_at) AND a.clinic_id::text IN (${clinic:sqlstring})\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "transformations": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cancelamentos por dia (por clínica)",
      "description": "Por data do cancelamento (cancelled_at).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clinicdb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clinicdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT (date_trunc('day', a.cancelled_at AT TIME ZONE c.timezone) AT TIME ZONE c.timezone) AS time,\n       c.name AS metric, count(*) AS value\nFROM appointment a JOIN clinic c ON c.id = a.clinic_id\nWHERE a.status = 'CANCELLED' AND $__timeFilter(a.cancelled_at) AND a.clinic_id::text IN (${clinic:sqlstring})\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
