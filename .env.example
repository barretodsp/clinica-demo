# ============================================================
# Variáveis de ambiente — EXEMPLO (valores fictícios de demonstração).
# Copie para .env:  cp .env.example .env
# Em qualquer ambiente real, troque TODAS as senhas e segredos.
# ============================================================

# --- Postgres (superusuário do container; usado só pelo script de init) ---
POSTGRES_PASSWORD=postgres-demo

# --- Papéis com privilégio mínimo (criados em docker/postgres/init) ---
CLINIC_OWNER_PASSWORD=owner-demo   # migrations e seed (DDL)
CLINIC_APP_PASSWORD=app-demo       # backend em execução (DML)
GRAFANA_DB_PASSWORD=grafana-demo   # Grafana (somente leitura)

# --- Porta do Postgres no host (somente 127.0.0.1): DBeaver e testes ---
# Dentro do compose, os serviços usam o host "postgres" (as URLs abaixo são para o host).
POSTGRES_PORT=5432
DATABASE_URL=postgres://clinic_app:app-demo@127.0.0.1:5432/clinic
DATABASE_MIGRATION_URL=postgres://clinic_owner:owner-demo@127.0.0.1:5432/clinic
DATABASE_URL_TEST=postgres://clinic_app:app-demo@127.0.0.1:5432/clinic_test
DATABASE_MIGRATION_URL_TEST=postgres://clinic_owner:owner-demo@127.0.0.1:5432/clinic_test

# --- Autenticação ---
# HS256 exige no mínimo 32 bytes. Gere com: openssl rand -base64 32
AUTH_SECRET=demo-auth-secret-troque-por-openssl-rand-base64-32
AUTH_TOKEN_TTL=1h
# Cookie com flag Secure. Chrome e Firefox aceitam em http://localhost e http://*.localhost
# (contexto seguro), então fica ligado. Use false só para acessar por outro host sem HTTPS.
COOKIE_SECURE=true

# --- Token de serviço (integração FHIR) — segredo PRÓPRIO, diferente do AUTH_SECRET ---
SERVICE_TOKEN_SECRET=demo-service-secret-troque-por-openssl-rand-base64-32
# Token gerado com `make service-token` (usado pelo cliente integrador e no README)
SERVICE_TOKEN=

# --- Backend ---
PORT=3000
LOG_LEVEL=info
# URL do Loki (vazio = não envia logs ao Loki; só stdout)
LOKI_URL=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-demo
